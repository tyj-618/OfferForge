# OfferForge 生产部署环境变量（复制为 .env 后填写，.env 不入库）
# 与现有项目共用 MySQL/Redis/ES，仅部署 backend + frontend

# ===== 中间件网络（现有 MySQL/Redis/ES 容器所在的 Docker 网络） =====
MIDDLEWARE_NETWORK=campuscircle_default

# ===== 端口映射（宿主机） =====
# backend: 127.0.0.1:8081 -> 容器 8080
# frontend(Nginx): 127.0.0.1:8082 -> 容器 80
OFFERFORGE_BACKEND_PORT=8081
OFFERFORGE_FRONTEND_PORT=8082

# ===== MySQL（复用现有实例） =====
# 后端已加入中间件所在 Docker 网络（MIDDLEWARE_NETWORK），直接用容器名 + 容器内部端口
OFFERFORGE_MYSQL_HOST=campuscircle-mysql
OFFERFORGE_MYSQL_PORT=3306
OFFERFORGE_MYSQL_DATABASE=offerforge_db
OFFERFORGE_DB_USERNAME=root
OFFERFORGE_DB_PASSWORD=***

# ===== Redis（复用现有实例） =====
OFFERFORGE_REDIS_HOST=campuscircle-redis
OFFERFORGE_REDIS_PORT=6379
OFFERFORGE_REDIS_PASSWORD=
# 建议为 OfferForge 使用独立 database，避免与现有项目键冲突
OFFERFORGE_REDIS_DATABASE=1

# ===== Elasticsearch（复用现有实例；置 false 则走 MySQL 关键词兜底检索） =====
OFFERFORGE_ES_HOST=campuscircle-elasticsearch
OFFERFORGE_ES_PORT=9200
OFFERFORGE_SEARCH_ENABLED=true
OFFERFORGE_SEARCH_EMBEDDING_PROVIDER=mock

# ===== LLM（可保持 mock，用户可在页面自带 Key；或配置平台 Key） =====
OFFERFORGE_AI_PROVIDER=mock
#OFFERFORGE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#OFFERFORGE_AI_API_KEY=sk-you…-key
#OFFERFORGE_AI_MODEL=qwen-plus

# ===== 免费额度 =====
OFFERFORGE_QUOTA_ENABLED=true
OFFERFORGE_QUOTA_DAILY_LIMIT=10

# ===== API Key 加密密钥（必须恰好 32 个 ASCII 字符） =====
# 生成方式：openssl rand -base64 24   或   head -c 32 /dev/urandom | base64 | head -c 32
APIKEY_ENCRYPT_KEY=change…s!!!
