# OfferForge 本地开发环境变量示例（复制为 .env 后填写真实值，.env 不入库）

# ===== MySQL =====
OFFERFORGE_DB_URL=jdbc:mysql://localhost:3308/offerforge?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
OFFERFORGE_DB_USERNAME=root
OFFERFORGE_DB_PASSWORD=offerforge_dev_pwd

# ===== Redis =====
OFFERFORGE_REDIS_HOST=localhost
OFFERFORGE_REDIS_PORT=6380
OFFERFORGE_REDIS_PASSWORD=
OFFERFORGE_REDIS_DATABASE=0

# ===== LLM（千问，百炼平台 OpenAI 兼容接口） =====
# provider: mock | openai-compatible
OFFERFORGE_AI_PROVIDER=openai-compatible
OFFERFORGE_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OFFERFORGE_AI_API_KEY=sk-your-dashscope-api-key
OFFERFORGE_AI_MODEL=qwen-plus
OFFERFORGE_AI_TIMEOUT_SECONDS=30
OFFERFORGE_AI_STREAM_READ_TIMEOUT_SECONDS=60
OFFERFORGE_AI_MAX_RETRIES=1
OFFERFORGE_AI_MAX_OUTPUT_TOKENS=1024

# ===== Elasticsearch + Embedding =====
# enabled=false 时走 MySQL 关键词兜底检索，无需 ES
OFFERFORGE_SEARCH_ENABLED=false
OFFERFORGE_SEARCH_BASE_URL=http://localhost:9201
OFFERFORGE_SEARCH_KNOWLEDGE_INDEX=offerforge-knowledge
OFFERFORGE_SEARCH_REQUEST_TIMEOUT_SECONDS=5
# embedding-provider: mock | openai-compatible
OFFERFORGE_SEARCH_EMBEDDING_PROVIDER=openai-compatible
OFFERFORGE_SEARCH_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OFFERFORGE_SEARCH_EMBEDDING_API_KEY=sk-your-dashscope-api-key
OFFERFORGE_SEARCH_EMBEDDING_MODEL=text-embedding-v4
OFFERFORGE_SEARCH_EMBEDDING_DIMENSIONS=1024
OFFERFORGE_SEARCH_EMBEDDING_TIMEOUT_SECONDS=20

# ===== Auth =====
OFFERFORGE_AUTH_REFRESH_COOKIE_SECURE=false

# ===== Interview（模拟面试状态机） =====
OFFERFORGE_INTERVIEW_MAX_FOLLOW_UPS=2
OFFERFORGE_INTERVIEW_MAX_BASICS_QUESTIONS=3
OFFERFORGE_INTERVIEW_MAX_PROJECT_QUESTIONS=2
OFFERFORGE_INTERVIEW_MAX_DEEP_QUESTIONS=3
OFFERFORGE_INTERVIEW_MESSAGE_WINDOW=12
OFFERFORGE_INTERVIEW_SESSION_TTL_SECONDS=7200
